[Unit]
Description=NekoMail background mail sync (Ultimit)
Documentation=file://@REPO@/ultimit/NOTES.md
After=network-online.target

[Service]
Type=simple
ExecStart=@BACKEND@/.venv/bin/python @BACKEND@/launcher.py
Environment=PYTHONUNBUFFERED=1
Environment=WINDOW_COMMAND=@BIN@/nekomail
Restart=on-failure
RestartSec=5
# launcher.py stops cleanly on SIGTERM (IDLE connections, runtime files).
TimeoutStopSec=20
NoNewPrivileges=yes

[Install]
WantedBy=default.target
