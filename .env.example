# Copy this to .env and fill in values. Back this file up alongside ./data —
# losing SECRET_KEY/MAIL_ENCRYPTION_KEY without losing the database makes every
# stored mail account credential permanently undecryptable.

# Database — SQLite file in the project's ./data folder (host-accessible).
# docker-compose overrides this with the in-container path; host tooling
# (alembic, scripts/) reads this value.
DATABASE_URL=sqlite+aiosqlite:///./data/nekomail.db

# Raw .eml storage root — host tooling default; docker-compose overrides to
# the in-container path (same ./data bind mount as the database above).
MAIL_STORAGE_PATH=./data/mail

# Generate with: openssl rand -hex 32
SECRET_KEY=changeme_generate_with_openssl_rand_hex_32
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MAIL_ENCRYPTION_KEY=changeme_generate_a_fernet_key

ADMIN_USERNAME=admin
ADMIN_PASSWORD=Idontknow556!

APP_PORT=8090
APP_NAME=NekoMail

# Set to true when serving over HTTPS (recommended once exposed beyond localhost)
COOKIE_SECURE=false

# Optional: enables the "Link Outlook Account" button (OAuth2/XOAUTH2).
# Leave AZURE_CLIENT_ID blank to disable it entirely -- NekoMail's core has
# no Microsoft dependency without this. Requires an Azure App Registration
# you create yourself; see NEXT_STEPS.md Phase 7 for the exact shape
# (redirect URI under the "Web" platform + "Allow public client flows" on --
# NOT the "Mobile and desktop applications" platform type).
AZURE_CLIENT_ID=
AZURE_AUTHORITY=https://login.microsoftonline.com/common
# Must match exactly what NekoMail is actually reached at, and be registered
# as {this}/api/accounts/oauth/outlook/callback in the Azure app.
PUBLIC_BASE_URL=http://localhost:8090
